{
  "title": "#0410 — Slack — Keybinding(s)",
  "rules": [

    {
      "description": "#0411 — Slack — Systemwide — Foreground (Shift-Ctrl-Cmd-S)",
      "manipulators": [
        {
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": [
                "left_shift",
                "left_control",
                "left_command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "osascript -e 'tell application \"Slack\" to reopen' -e 'tell application \"Slack\" to activate'"
            }
          ],
          "type": "basic"
        }
      ]
    }

